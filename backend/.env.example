# Copy this file to .env and fill in real values. Never commit the real .env.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecocompute
PORT=5000
NODE_ENV=production

# Comma-separated list of origins allowed to call this API (your frontend's deployed URL).
CORS_ORIGINS=https://your-frontend.onrender.com

# --- Auth (single admin) ---
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Credential encryption for stored cloud connections (AES-256-GCM key) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- AWS (optional: only needed for 'delegated role' connections, where the
# server itself must be allowed to sts:AssumeRole into the customer's role) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- SMTP (optional: only needed to actually deliver scheduled report
# emails — see Reports screen. Without these, schedules still save fine,
# the server just never sends them. Any standard SMTP provider works
# (SendGrid, Mailgun, SES, Gmail with an app password, ...). ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# If set (and SMTP above is configured), a notification email goes to this
# address whenever someone submits the Landing page's "Book a walkthrough"
# form. Leave blank to only see new leads on the Leads screen in-app.
LEADS_NOTIFY_EMAIL=
