# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Local Environment Variables
.env
backend/.env

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
frontend/build/
dist/

# Uploaded CSVs land here transiently and are deleted after processing —
# never commit anything a user uploaded.
backend/uploads/*
!backend/uploads/.gitkeep